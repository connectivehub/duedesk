# Meta WhatsApp Cloud API. Create these in the Meta app dashboard.
# Never commit real values. On Vercel, store them as sensitive environment variables.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional. Defaults to v26.0.
WHATSAPP_GRAPH_VERSION=

# Supabase server access. Do not use the anon or publishable key here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Prefer a restricted key (rk_) that can write and read Checkout Sessions.
# The webhook secret is the signing secret for /api/stripe/webhook, not the API key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# /admin password. Use a long random value.
ADMIN_PASSWORD=
# Inbox that should hear when a chat needs Leon. Logged as well.
ADMIN_NOTIFY_EMAIL=

# Optional. Without these, handoff alerts are only written to the server log.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional. Used only to read a company name, UEN, or year from a free-text message.
# Pick a text model from https://ai-gateway.vercel.sh/v1/models and prefer zero data retention.
# Customers are never told this is in use. Leave both blank to stay fully deterministic.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Optional. Payment return links. Defaults to https://duedesk.connective-labs.com.
APP_BASE_URL=
